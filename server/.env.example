# Server environment — placeholders only. Copy to server/.env

PORT=5000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Local demonstration without Amplify/Cognito (set false for real auth)
DEMO_MODE=true
DEMO_USERNAME=demo
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=andale_db

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Charity Navigator GraphQL API — https://developer.charitynavigator.org/
# Used by: npm run sync:charities  and  POST /api/synccharities
CHARITY_NAVIGATOR_API_KEY=your_charity_navigator_api_key
# CHARITY_NAVIGATOR_API_URL=https://api.charitynavigator.org/graphql
# CN_SYNC_LIMIT=100

COGNITO_USER_POOL_ID=us-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_app_client_id
