# Copy to server/.env (or repo-root .env) and fill in real values.
# Never commit real secrets.

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Demo mode (no Amplify) — also set REACT_APP_DEMO_MODE=true in client/.env.development
DEMO_MODE=true
DEMO_USERNAME=demo
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=andale_db

# Stripe (use a test key locally; rotate any key that was ever committed)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Charity Navigator GraphQL API — https://developer.charitynavigator.org/
CHARITY_NAVIGATOR_API_KEY=your_charity_navigator_api_key

# AWS Cognito (from Amplify aws-exports / Cognito console)
COGNITO_USER_POOL_ID=us-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_app_client_id

# Optional legacy PayPal (rotate if previously exposed in git history)
# PAYPAL_CLIENT_ID=
# APP_SECRET=
